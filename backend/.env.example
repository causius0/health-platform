# Configurazione backend Health Platform — copiare in .env e compilare.

# PostgreSQL (produzione: credenziali dedicate)
DATABASE_URL=postgresql+psycopg://health:health@localhost:5432/health_platform

# Segreto JWT: generare con `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET_KEY=

# LLM per la chat. Due modalità:
#  1) OpenRouter (hosted): inserisci la chiave e il modello OpenRouter
#  2) Locale (Ollama): OPENROUTER_URL=http://localhost:11434/v1/chat/completions,
#     chiave vuota, model es. mistral-3b (Ministral 3B Q4, ufficiale Mistral) / qwen2.5:3b / hermes3
# Senza endpoint raggiungibile l'assistente usa il fallback deterministico.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/ministral-3b-2512
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
LLM_TIMEOUT=90

# Impostare a 0 quando lo schema è gestito con Alembic
DB_AUTO_CREATE=1
